{
  "status": "evaluation_completed",
  "idea": "Transfer trial_0004 primal stochastic-knapsack marginal gap cost into the strong public seed.",
  "parent": "seed_public_best",
  "source": "/Users/555tery/techarena/research-campaigns/20261018T141843+0700-autonomous/branches/primal_transfer/primal_gap_dp.cpp",
  "source_sha256": "3aa24d9bb7b16520b29f753774283ba8062ba775ff88a710b10d13e7eb4673a3",
  "parent_source_sha256": "c70ade5c1ecd48c8f74ed99582f974467bd2b1791a214d79ddf6e5df8729af29",
  "mechanism": {
    "history": "2048 most recent valid operations; placement demand is recorded after the current placement decision.",
    "rates": "lambda_s = recent placements of size s / current number of free gaps fitting s; expiry = 2 * recent deletes / live pipes.",
    "cost": "DP marginal value V(g) - V(g - request), minimizing over the seed’s existing distinct-gap-size candidates.",
    "scope": "Only ordinary, non-parity allocation when activePipeCount > 4096, after all existing structural routing; MC is already disabled there.",
    "candidate_domain": "Exactly the seed domain, including the first distinct gap size with slack > 40 before stopping; preserve its current address representatives and side-aware tie rules.",
    "compute_cap": "Compute through the largest candidate size if <=512; if the domain exceeds 512, use the original score for the entire decision."
  },
  "causal_hypothesis": "A gap’s immediate slack is an incomplete proxy for reusable capacity. Empirical per-size demand adjusted for the number of currently fitting gaps, plus a global observed deletion hazard, may rank existing large-state choices better by expected future reusable space, especially in mixed-size/high-fragmentation states. It uses only past operations and current free gaps; it has no test identity or future-trace dispatch.",
  "changes": [
    "Added a separate 2048-operation demand/deletion window and coalesced-gap-size histogram.",
    "Added the primal knapsack Bellman value and gated its marginal cost to ordinary non-parity states above 4096 live pipes.",
    "Kept cohort/run/trend/LIFO routing, free-gap candidate domain, address representatives, side tie-breaks, rollout state, and all other policies unchanged.",
    "Added end-of-run stderr counters for DP activations, changed selections, first activation event, cap fallbacks, and model rebuilds."
  ],
