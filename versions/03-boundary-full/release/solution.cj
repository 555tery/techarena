    @OverflowWrapping
    public func ensurePrimalGapValues(maxGap: Int64): Bool {
        if (maxGap <= 0 || maxGap > kPrimalGapValueCap) { return false }
        if (primalModelDirty || primalStep - primalModelStep >= 64 || maxGap > primalComputedLimit) { rebuildPrimalGapValues(maxGap) }
        return hasRecentPrimalDemand()
    }

    @OverflowWrapping
    public func rebuildCausalGapValues(maxGap: Int64, model: Int64): Unit {
        if (maxGap < 0 || maxGap > kPrimalGapValueCap || model < 0 || model > 1) { throw IndexOutOfBoundsException("DP row or limit") }
        // All indices are within rates/reward[0..40], value[0..512]
        // or causal rows[0..1025]; this owns every buffer throughout.
        unsafe {
            let reward = dpRewardScratch.borrowData()
            let requestRates = causalRequestRate.borrowData()
            var lastRequest: Int64 = 40
            while (lastRequest > 0 && requestRates.read(lastRequest) == 0.0) { lastRequest-- }
            var firstRequest: Int64 = 1
            while (firstRequest <= lastRequest && requestRates.read(firstRequest) == 0.0) { firstRequest++ }
            let gapValues = causalGapValue.borrowData()
            // Coefficients stay frozen until a primal refresh resets both
            // logical limits to zero. Each row depends only on its own prefix
            // and frozen coefficients; scratch rewards are overwritten before
            // every active read. The two zero-gap cells are never written.
            let firstGap = if (model == 0) { causalHalfComputedLimit + 1 } else { causalDoubleComputedLimit + 1 }
            let offset: Int64 = model * 513
            let expiry = causalBaseExpiry * (if (model == 0) { 0.5 } else { 2.0 })
            for (gap in firstGap..=maxGap) {
                let top = iMin(gap, lastRequest)
                var active: Int64 = 0
                var minActiveReward = Float64.Inf
                var numerator: Float64 = 0.0
                var denominator = expiry
                if (gap >= 40 && lastRequest > 8) {
                    let requestRate1 = requestRates.read(1)
                    if (requestRate1 != 0.0) {
                        let requestReward1 = Float64(1) + gapValues.read(offset + gap - 1)
                        if (requestReward1 < minActiveReward) { minActiveReward = requestReward1 }
                        reward.write(1, requestReward1)
                        numerator += requestRate1 * requestReward1
                        denominator += requestRate1
                        active = active | (1 << 1)
                    }
                    let requestRate2 = requestRates.read(2)
                    if (requestRate2 != 0.0) {
                        let requestReward2 = Float64(2) + gapValues.read(offset + gap - 2)
                        if (requestReward2 < minActiveReward) { minActiveReward = requestReward2 }
                        reward.write(2, requestReward2)
                        numerator += requestRate2 * requestReward2
                        denominator += requestRate2
                        active = active | (1 << 2)
                    }
                    let requestRate3 = requestRates.read(3)
                    if (requestRate3 != 0.0) {
                        let requestReward3 = Float64(3) + gapValues.read(offset + gap - 3)
                        if (requestReward3 < minActiveReward) { minActiveReward = requestReward3 }
                        reward.write(3, requestReward3)
                        numerator += requestRate3 * requestReward3
                        denominator += requestRate3
                        active = active | (1 << 3)
                    }
                    let requestRate4 = requestRates.read(4)
                    if (requestRate4 != 0.0) {
                        let requestReward4 = Float64(4) + gapValues.read(offset + gap - 4)
                        if (requestReward4 < minActiveReward) { minActiveReward = requestReward4 }
                        reward.write(4, requestReward4)
                        numerator += requestRate4 * requestReward4
                        denominator += requestRate4
                        active = active | (1 << 4)
                    }
                    let requestRate5 = requestRates.read(5)
                    if (requestRate5 != 0.0) {
                        let requestReward5 = Float64(5) + gapValues.read(offset + gap - 5)
                        if (requestReward5 < minActiveReward) { minActiveReward = requestReward5 }
                        reward.write(5, requestReward5)
                        numerator += requestRate5 * requestReward5
                        denominator += requestRate5
                        active = active | (1 << 5)
                    }
                    let requestRate6 = requestRates.read(6)
                    if (requestRate6 != 0.0) {
                        let requestReward6 = Float64(6) + gapValues.read(offset + gap - 6)
                        if (requestReward6 < minActiveReward) { minActiveReward = requestReward6 }
                        reward.write(6, requestReward6)
