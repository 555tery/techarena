package pipes

import std.collection.*
import std.math.*
import std.env.*
import std.runtime.*

// Source: common.cj
func iMin(a: Int64, b: Int64): Int64 { if (a < b) { a } else { b } }
func iMax(a: Int64, b: Int64): Int64 { if (a > b) { a } else { b } }
func fMin(a: Float64, b: Float64): Float64 { if (a < b) { a } else { b } }
func fMax(a: Float64, b: Float64): Float64 { if (a > b) { a } else { b } }

// The live domains are nonnegative and fit Int64, including release epochs.
public struct Key {
    public let a: Int64
    public let b: Int64
    public let c: Int64
    public init(a: Int64) { this.a = a; this.b = 0; this.c = 0 }
    public init(a: Int64, b: Int64) { this.a = a; this.b = b; this.c = 0 }
    public init(a: Int64, b: Int64, c: Int64) { this.a = a; this.b = b; this.c = c }
}

func compareKey(a: Key, b: Key): Int64 {
    if (a.a != b.a) { return if (a.a < b.a) { -1 } else { 1 } }
    if (a.b != b.b) { return if (a.b < b.b) { -1 } else { 1 } }
    if (a.c != b.c) { return if (a.c < b.c) { -1 } else { 1 } }
    return 0
}

// AVL tree with stable node IDs. Erasing a node transplants its successor;
// it never swaps another live node's key or payload into the erased node ID.
// Arrays and recycled node slots avoid one managed allocation per tree node.
// Native backing vectors for AVL storage. Each Int64 allocation has one
// FastIntVector owner; no managed-array pinning or exported pointer is used.
public class FastIntVector {
    private var data: CPointer<Int64>
    private var capacity: Int64 = 16
    private var used: Int64 = 0

    public init() {
        data = LibC.malloc<Int64>(count: 16)
        if (data.isNull()) { throw IllegalMemoryException("Integer vector allocation failed") }
    }

    ~init() { unsafe { LibC.free(data) } }

    public prop size: Int64 { get() { used } }

    // Package-internal, transient read-only borrows; callers retain this owner
    // and finish the borrow before add/reserve can replace the allocation.
    @OverflowWrapping
    func borrowData(): CPointer<Int64> { data }

    @OverflowWrapping
    public operator func [](index: Int64): Int64 {
        if (index < 0 || index >= used) { throw IndexOutOfBoundsException("Integer vector index") }
        return unsafe { data.read(index) }
    }

    @OverflowWrapping
    public operator func [](index: Int64, value!: Int64): Unit {
        if (index < 0 || index >= used) { throw IndexOutOfBoundsException("Integer vector index") }
        unsafe { data.write(index, value) }
    }

    // Package-internal so FastKeyVector can reserve all three columns before
    // committing any component. Failed reservation leaves all sizes intact.
    @OverflowWrapping
    func reserveForAdd(): Unit {
        if (used < capacity) { return }
        if (capacity > Int64.Max / 2) { throw IllegalMemoryException("Integer vector capacity overflow") }
        let expandedCapacity = capacity * 2
        let expanded = LibC.malloc<Int64>(count: expandedCapacity)
        if (expanded.isNull()) { throw IllegalMemoryException("Integer vector expansion failed") }
        unsafe {
            for (i in 0..used) { expanded.write(i, data.read(i)) }
        }
        let previous = data
        data = expanded
        capacity = expandedCapacity
        unsafe { LibC.free(previous) }
    }

    @OverflowWrapping
    public func add(value: Int64): Unit {
        reserveForAdd()
        unsafe { data.write(used, value) }
        used++
    }

    @OverflowWrapping
    public func remove(at!: Int64): Int64 {
        if (used == 0 || at != used - 1) { throw IndexOutOfBoundsException("Only last-element removal is supported") }
        let value = unsafe { data.read(at) }
        used--
        unsafe { data.write(used, 0) }
        return value
    }

    @OverflowWrapping
    public func clone(): FastIntVector {
        let result = FastIntVector()
        for (i in 0..used) { result.add(unsafe { data.read(i) }) }
        return result
    }
}

public class FastKeyVector {
    private var data: CPointer<Int64>
    private var capacity: Int64 = 16
    private var used: Int64 = 0

    public init() {
        data = LibC.malloc<Int64>(count: 48)
        if (data.isNull()) { throw IllegalMemoryException("Key vector allocation failed") }
    }

    ~init() { unsafe { LibC.free(data) } }

    public prop size: Int64 { get() { used } }

    // Package-internal, transient read-only borrows; callers retain this owner
    // and finish the borrow before add/reserve can replace the allocation.
    @OverflowWrapping
    func borrowData(): CPointer<Int64> { data }

    @OverflowWrapping
    public operator func [](index: Int64): Key {
        if (index < 0 || index >= used) { throw IndexOutOfBoundsException("Key vector index") }
        let offset = index * 3
        return unsafe { Key(data.read(offset), data.read(offset + 1), data.read(offset + 2)) }
    }

    @OverflowWrapping
    public operator func [](index: Int64, value!: Key): Unit {
        if (index < 0 || index >= used) { throw IndexOutOfBoundsException("Key vector index") }
        let offset = index * 3
        unsafe {
            data.write(offset, value.a)
            data.write(offset + 1, value.b)
            data.write(offset + 2, value.c)
        }
    }

    // Same sign as compareKey(wanted, this[index]); later components are
    // read only when every preceding component compares equal.
    @OverflowWrapping
    public func compareAt(index: Int64, wanted: Key): Int64 {
        if (index < 0 || index >= used) { throw IndexOutOfBoundsException("Key vector index") }
        let offset = index * 3
        let first = unsafe { data.read(offset) }
        if (wanted.a != first) { return if (wanted.a < first) { -1 } else { 1 } }
        let second = unsafe { data.read(offset + 1) }
        if (wanted.b != second) { return if (wanted.b < second) { -1 } else { 1 } }
        let third = unsafe { data.read(offset + 2) }
        if (wanted.c != third) { return if (wanted.c < third) { -1 } else { 1 } }
        return 0
    }

    @OverflowWrapping
    private func reserveForAdd(): Unit {
        if (used < capacity) { return }
        if (capacity > Int64.Max / 2) { throw IllegalMemoryException("Key capacity overflow") }
        let expandedCapacity = capacity * 2
        if (expandedCapacity > Int64.Max / 3) { throw IllegalMemoryException("Key payload overflow") }
        let expanded = LibC.malloc<Int64>(count: expandedCapacity * 3)
        if (expanded.isNull()) { throw IllegalMemoryException("Key vector expansion failed") }
        unsafe {
            for (i in 0..(used * 3)) { expanded.write(i, data.read(i)) }
        }
        let previous = data
        data = expanded
        capacity = expandedCapacity
        unsafe { LibC.free(previous) }
    }

    @OverflowWrapping
    public func add(value: Key): Unit {
        reserveForAdd()
        let offset = used * 3
        unsafe {
            data.write(offset, value.a)
            data.write(offset + 1, value.b)
            data.write(offset + 2, value.c)
        }
        used++
    }

    @OverflowWrapping
    public func remove(at!: Int64): Key {
        if (used == 0 || at != used - 1) { throw IndexOutOfBoundsException("Only last-key removal is supported") }
        let offset = at * 3
        let value = unsafe { Key(data.read(offset), data.read(offset + 1), data.read(offset + 2)) }
        used--
        unsafe {
            data.write(offset, 0)
            data.write(offset + 1, 0)
            data.write(offset + 2, 0)
        }
        return value
    }

    @OverflowWrapping
    public func clone(): FastKeyVector {
        let result = FastKeyVector()
        for (i in 0..used) { result.add(this[i]) }
        return result
    }
}

public class OrderedMap<V> {
    private let zero: V
    private var root: Int64 = 0
    private var count: Int64 = 0
    private var left = FastIntVector()
    private var right = FastIntVector()
    private var parent = FastIntVector()
    private var heights = FastIntVector()
    private var keys = FastKeyVector()
    private var values = ArrayList<V>()
    private var vacant = FastIntVector()

    public init(defaultValue: V) {
        zero = defaultValue
        left.add(0); right.add(0); parent.add(0); heights.add(0)
        keys.add(Key(0)); values.add(defaultValue)
    }
    public prop size: Int64 { get() { count } }
    @OverflowWrapping
    public func isEmpty(): Bool { count == 0 }
    @OverflowWrapping
    public func key(node: Int64): Key { keys[node] }
    @OverflowWrapping
    public func keyA(node: Int64): Int64 {
        if (node < 0 || node >= keys.size) { throw IndexOutOfBoundsException("AVL key index") }
        let data = keys.borrowData()
        let result = unsafe { data.read(node * 3 + 0) }
        blackBox(this)
        return result
    }
    @OverflowWrapping
    public func keyB(node: Int64): Int64 {
        if (node < 0 || node >= keys.size) { throw IndexOutOfBoundsException("AVL key index") }
        let data = keys.borrowData()
        let result = unsafe { data.read(node * 3 + 1) }
        blackBox(this)
        return result
    }
    @OverflowWrapping
    public func keyC(node: Int64): Int64 {
        if (node < 0 || node >= keys.size) { throw IndexOutOfBoundsException("AVL key index") }
        let data = keys.borrowData()
        let result = unsafe { data.read(node * 3 + 2) }
        blackBox(this)
        return result
    }
    @OverflowWrapping
    public func value(node: Int64): V { values[node] }
    @OverflowWrapping
    public func setValue(node: Int64, value: V): Unit { values[node] = value }

    @OverflowWrapping
    public func first(): Int64 {
        var node = root
        let nodeSlots = keys.size
        if (node < 0 || node >= nodeSlots) { throw IndexOutOfBoundsException("AVL node index") }
        unsafe {
            let edgeData = left.borrowData()
            while (node != 0) {
                let child = edgeData.read(node)
                if (child == 0) { break }
                node = child
            }
        }
        // Public1.0.5 optimizer black box retains the strong owner use.
        blackBox(this)
        if (node < 0 || node >= this.keys.size) { throw IndexOutOfBoundsException("AVL node index") }
        return node
    }
    @OverflowWrapping
    public func last(): Int64 {
        var node = root
        let nodeSlots = keys.size
        if (node < 0 || node >= nodeSlots) { throw IndexOutOfBoundsException("AVL node index") }
        unsafe {
            let edgeData = right.borrowData()
            while (node != 0) {
                let child = edgeData.read(node)
                if (child == 0) { break }
                node = child
            }
        }
        // Public1.0.5 optimizer black box retains the strong owner use.
        blackBox(this)
        if (node < 0 || node >= this.keys.size) { throw IndexOutOfBoundsException("AVL node index") }
        return node
    }
    @OverflowWrapping
    public func next(node: Int64): Int64 {
        if (node == 0) { return 0 }
        let nodeSlots = keys.size
        if (node < 0 || node >= nodeSlots) { throw IndexOutOfBoundsException("AVL node index") }
        var answer: Int64 = 0
        unsafe {
            let leftData = left.borrowData()
            let rightData = right.borrowData()
            let parentData = parent.borrowData()
            var cur = node
            let child = rightData.read(cur)
            if (child != 0) {
                cur = child
                while (true) {
                    let following = leftData.read(cur)
                    if (following == 0) { break }
                    cur = following
                }
                answer = cur
            } else {
                var p = parentData.read(cur)
                while (p != 0 && cur == rightData.read(p)) { cur = p; p = parentData.read(cur) }
                answer = p
            }
        }
        // Public1.0.5 optimizer black box retains the strong owner use.
        blackBox(this)
        if (answer < 0 || answer >= this.keys.size) { throw IndexOutOfBoundsException("AVL node index") }
        return answer
    }
    @OverflowWrapping
    public func prev(node: Int64): Int64 {
        if (node == 0) { return last() }
        let nodeSlots = keys.size
        if (node < 0 || node >= nodeSlots) { throw IndexOutOfBoundsException("AVL node index") }
        var answer: Int64 = 0
        unsafe {
            let leftData = left.borrowData()
            let rightData = right.borrowData()
            let parentData = parent.borrowData()
            var cur = node
            let child = leftData.read(cur)
            if (child != 0) {
                cur = child
                while (true) {
                    let following = rightData.read(cur)
                    if (following == 0) { break }
                    cur = following
                }
                answer = cur
            } else {
                var p = parentData.read(cur)
                while (p != 0 && cur == leftData.read(p)) { cur = p; p = parentData.read(cur) }
                answer = p
            }
        }
        // Public1.0.5 optimizer black box retains the strong owner use.
        blackBox(this)
        if (answer < 0 || answer >= this.keys.size) { throw IndexOutOfBoundsException("AVL node index") }
        return answer
    }
    @OverflowWrapping
    public func find(wanted: Key): Int64 {
        var node = root
        let nodeSlots = keys.size
        if (node < 0 || node >= nodeSlots) { throw IndexOutOfBoundsException("AVL node index") }
        unsafe {
            let leftData = left.borrowData()
            let rightData = right.borrowData()
            let keyData = keys.borrowData()
            while (node != 0) {
                let offset = node * 3
                let first = keyData.read(offset)
                var keyOrder: Int64 = 0
                if (wanted.a != first) { keyOrder = if (wanted.a < first) { -1 } else { 1 } }
                else {
                    let second = keyData.read(offset + 1)
                    if (wanted.b != second) { keyOrder = if (wanted.b < second) { -1 } else { 1 } }
                    else {
                        let third = keyData.read(offset + 2)
                        if (wanted.c != third) { keyOrder = if (wanted.c < third) { -1 } else { 1 } }
                    }
                }
                let order = keyOrder
                if (order == 0) { break }
                node = if (order < 0) { leftData.read(node) } else { rightData.read(node) }
            }
        }
        // Public1.0.5 optimizer black box retains the strong owner use.
        blackBox(this)
        if (node < 0 || node >= this.keys.size) { throw IndexOutOfBoundsException("AVL node index") }
        return node
    }
    @OverflowWrapping
    public func lower(wanted: Key): Int64 {
        var node = root
        let nodeSlots = keys.size
        if (node < 0 || node >= nodeSlots) { throw IndexOutOfBoundsException("AVL node index") }
        var answer: Int64 = 0
        unsafe {
            let leftData = left.borrowData()
            let rightData = right.borrowData()
            let keyData = keys.borrowData()
            while (node != 0) {
                let offset = node * 3
                let first = keyData.read(offset)
                var keyOrder: Int64 = 0
                if (wanted.a != first) { keyOrder = if (wanted.a < first) { -1 } else { 1 } }
                else {
                    let second = keyData.read(offset + 1)
                    if (wanted.b != second) { keyOrder = if (wanted.b < second) { -1 } else { 1 } }
                    else {
                        let third = keyData.read(offset + 2)
                        if (wanted.c != third) { keyOrder = if (wanted.c < third) { -1 } else { 1 } }
                    }
                }
                let order = keyOrder
                if (order <= 0) {
                    answer = node; node = leftData.read(node)
                } else { node = rightData.read(node) }
            }
        }
        // Public1.0.5 optimizer black box retains the strong owner use.
        blackBox(this)
        if (answer < 0 || answer >= this.keys.size) { throw IndexOutOfBoundsException("AVL node index") }
        return answer
    }
    @OverflowWrapping
    public func upper(wanted: Key): Int64 {
        var node = root
        let nodeSlots = keys.size
        if (node < 0 || node >= nodeSlots) { throw IndexOutOfBoundsException("AVL node index") }
        var answer: Int64 = 0
        unsafe {
            let leftData = left.borrowData()
            let rightData = right.borrowData()
            let keyData = keys.borrowData()
            while (node != 0) {
                let offset = node * 3
                let first = keyData.read(offset)
                var keyOrder: Int64 = 0
                if (wanted.a != first) { keyOrder = if (wanted.a < first) { -1 } else { 1 } }
                else {
                    let second = keyData.read(offset + 1)
                    if (wanted.b != second) { keyOrder = if (wanted.b < second) { -1 } else { 1 } }
                    else {
                        let third = keyData.read(offset + 2)
                        if (wanted.c != third) { keyOrder = if (wanted.c < third) { -1 } else { 1 } }
                    }
                }
                let order = keyOrder
                if (order < 0) {
                    answer = node; node = leftData.read(node)
                } else { node = rightData.read(node) }
            }
        }
        // Public1.0.5 optimizer black box retains the strong owner use.
        blackBox(this)
        if (answer < 0 || answer >= this.keys.size) { throw IndexOutOfBoundsException("AVL node index") }
        return answer
    }
    @OverflowWrapping
    private func fixHeight(node: Int64): Unit {
        let allocated = keys.size
        if (node < 0 || node >= allocated) { throw IndexOutOfBoundsException("AVL node") }
        let navLeft = left.borrowData()
        let navRight = right.borrowData()
        let navHeights = heights.borrowData()
        unsafe {
            navHeights.write(node, 1 + iMax(navHeights.read(navLeft.read(node)), navHeights.read(navRight.read(node))))
        
            // No helper below resizes these vectors. The owner check
            // after the final pointer use keeps all buffers reachable.
            blackBox(this)
            if (keys.size != allocated) { throw IllegalStateException("AVL storage changed") }
        }
    }
    @OverflowWrapping
    private func replaceAtParent(oldNode: Int64, newNode: Int64): Unit {
        let allocated = keys.size
        if (oldNode < 0 || oldNode >= allocated || newNode < 0 || newNode >= allocated) { throw IndexOutOfBoundsException("AVL node") }
        let navLeft = left.borrowData()
        let navRight = right.borrowData()
        let navParent = parent.borrowData()
        unsafe {
            let p = navParent.read(oldNode)
            if (p == 0) { root = newNode }
            else if (navLeft.read(p) == oldNode) { navLeft.write(p, newNode) }
            else { navRight.write(p, newNode) }
            if (newNode != 0) { navParent.write(newNode, p) }
        
            // No helper below resizes these vectors. The owner check
            // after the final pointer use keeps all buffers reachable.
            blackBox(this)
            if (keys.size != allocated) { throw IllegalStateException("AVL storage changed") }
        }
    }
    @OverflowWrapping
    private func rotateLeft(node: Int64): Int64 {
        let allocated = keys.size
        if (node < 0 || node >= allocated) { throw IndexOutOfBoundsException("AVL node") }
        let navLeft = left.borrowData()
        let navRight = right.borrowData()
        let navParent = parent.borrowData()
        let navHeights = heights.borrowData()
        unsafe {
            let top = navRight.read(node)
            let middle = navLeft.read(top)
            let rotationParent = navParent.read(node)
            if (rotationParent == 0) { root = top }
            else if (navLeft.read(rotationParent) == node) { navLeft.write(rotationParent, top) }
            else { navRight.write(rotationParent, top) }
            if (top != 0) { navParent.write(top, rotationParent) }
            navLeft.write(top, node); navParent.write(node, top)
            navRight.write(node, middle)
            if (middle != 0) { navParent.write(middle, node) }
            navHeights.write(node, 1 + iMax(navHeights.read(navLeft.read(node)), navHeights.read(navRight.read(node))))
            navHeights.write(top, 1 + iMax(navHeights.read(navLeft.read(top)), navHeights.read(navRight.read(top))))
            // No helper below resizes these vectors. The owner check
            // after the final pointer use keeps all buffers reachable.
            blackBox(this)
            if (keys.size != allocated) { throw IllegalStateException("AVL storage changed") }
            return top
        }
    }
    @OverflowWrapping
    private func rotateRight(node: Int64): Int64 {
        let allocated = keys.size
        if (node < 0 || node >= allocated) { throw IndexOutOfBoundsException("AVL node") }
        let navLeft = left.borrowData()
        let navRight = right.borrowData()
        let navParent = parent.borrowData()
        let navHeights = heights.borrowData()
        unsafe {
            let top = navLeft.read(node)
            let middle = navRight.read(top)
            let rotationParent = navParent.read(node)
            if (rotationParent == 0) { root = top }
            else if (navLeft.read(rotationParent) == node) { navLeft.write(rotationParent, top) }
            else { navRight.write(rotationParent, top) }
            if (top != 0) { navParent.write(top, rotationParent) }
            navRight.write(top, node); navParent.write(node, top)
            navLeft.write(node, middle)
            if (middle != 0) { navParent.write(middle, node) }
            navHeights.write(node, 1 + iMax(navHeights.read(navLeft.read(node)), navHeights.read(navRight.read(node))))
            navHeights.write(top, 1 + iMax(navHeights.read(navLeft.read(top)), navHeights.read(navRight.read(top))))
            // No helper below resizes these vectors. The owner check
            // after the final pointer use keeps all buffers reachable.
            blackBox(this)
            if (keys.size != allocated) { throw IllegalStateException("AVL storage changed") }
            return top
        }
    }
    @OverflowWrapping
    private func rebalance(start: Int64): Unit {
        if (start == 0) { return }
        let allocated = keys.size
        if (start < 0 || start >= allocated) { throw IndexOutOfBoundsException("AVL node") }
        let navLeft = left.borrowData()
        let navRight = right.borrowData()
        let navParent = parent.borrowData()
        let navHeights = heights.borrowData()
        unsafe {
            var node = start
            while (node != 0) {
                let oldHeight = navHeights.read(node)
                navHeights.write(node, 1 + iMax(navHeights.read(navLeft.read(node)), navHeights.read(navRight.read(node))))
                let balance = navHeights.read(navLeft.read(node)) - navHeights.read(navRight.read(node))
                if (balance > 1) {
                    let child = navLeft.read(node)
                    if (navHeights.read(navLeft.read(child)) < navHeights.read(navRight.read(child))) { rotateLeft(child) }
                    node = rotateRight(node)
                } else if (balance < -1) {
                    let child = navRight.read(node)
                    if (navHeights.read(navRight.read(child)) < navHeights.read(navLeft.read(child))) { rotateRight(child) }
                    node = rotateLeft(node)
                }
                // The repaired subtree has the same height as before the
                // mutation. Ancestors retain their heights and balances.
                if (navHeights.read(node) == oldHeight) { break }
                node = navParent.read(node)
            }
        
            // No helper below resizes these vectors. The owner check
            // after the final pointer use keeps all buffers reachable.
            blackBox(this)
            if (keys.size != allocated) { throw IllegalStateException("AVL storage changed") }
        }
    }
    @OverflowWrapping
    private func newNode(k: Key, v: V, p: Int64): Int64 {
        var node: Int64
        if (vacant.size > 0) {
            node = vacant.remove(at: vacant.size - 1)
            left[node] = 0; right[node] = 0; parent[node] = p
            heights[node] = 1; keys[node] = k; values[node] = v
        } else {
            node = keys.size
            left.add(0); right.add(0); parent.add(p); heights.add(1)
            keys.add(k); values.add(v)
        }
        count++
        return node
    }
    @OverflowWrapping
    public func put(k: Key, v: V): Int64 {
        var node = root
        var p: Int64 = 0
        var order: Int64 = 0
        let nodeSlots = keys.size
        if (node < 0 || node >= nodeSlots) { throw IndexOutOfBoundsException("AVL node index") }
        // This scope ends before values writes, newNode, append, or rebalance.
        unsafe {
            let leftData = left.borrowData()
            let rightData = right.borrowData()
            let keyData = keys.borrowData()
            while (node != 0) {
                let offset = node * 3
                let first = keyData.read(offset)
                var keyOrder: Int64 = 0
                if (k.a != first) { keyOrder = if (k.a < first) { -1 } else { 1 } }
                else {
                    let second = keyData.read(offset + 1)
                    if (k.b != second) { keyOrder = if (k.b < second) { -1 } else { 1 } }
                    else {
                        let third = keyData.read(offset + 2)
                        if (k.c != third) { keyOrder = if (k.c < third) { -1 } else { 1 } }
                    }
                }
                order = keyOrder
                if (order == 0) { break }
                p = node
                node = if (order < 0) { leftData.read(node) } else { rightData.read(node) }
            }
        }
        blackBox(this)
        if (node != 0) { values[node] = v; return node }
        let added = newNode(k, v, p)
        if (p == 0) { root = added }
        else if (order < 0) { left[p] = added }
        else { right[p] = added }
        rebalance(p)
        return added
    }
    @OverflowWrapping
    public func eraseKey(k: Key): Unit {
        let node = find(k)
        if (node != 0) { eraseNode(node) }
    }
    @OverflowWrapping
    public func eraseNode(node: Int64): Unit {
        if (node == 0) { return }
        let allocated = keys.size
        if (node < 0 || node >= allocated) { throw IndexOutOfBoundsException("AVL node") }
        let navLeft = left.borrowData()
        let navRight = right.borrowData()
        let navParent = parent.borrowData()
        let navHeights = heights.borrowData()
        unsafe {
            var repair: Int64
            if (navLeft.read(node) == 0 || navRight.read(node) == 0) {
                repair = navParent.read(node)
                let child = if (navLeft.read(node) != 0) { navLeft.read(node) } else { navRight.read(node) }
                replaceAtParent(node, child)
            } else {
                var successor = navRight.read(node)
                while (navLeft.read(successor) != 0) { successor = navLeft.read(successor) }
                if (navParent.read(successor) != node) {
                    repair = navParent.read(successor)
                    replaceAtParent(successor, navRight.read(successor))
                    navRight.write(successor, navRight.read(node))
                    navParent.write(navRight.read(successor), successor)
                } else { repair = successor }
                replaceAtParent(node, successor)
                navLeft.write(successor, navLeft.read(node))
                navParent.write(navLeft.read(successor), successor)
                navHeights.write(successor, navHeights.read(node))
            }
            navLeft.write(node, 0); navRight.write(node, 0); navParent.write(node, 0); navHeights.write(node, 0)
            values[node] = zero
            vacant.add(node); count--
            rebalance(repair)
        
            // No helper below resizes these vectors. The owner check
            // after the final pointer use keeps all buffers reachable.
            blackBox(this)
            if (keys.size != allocated) { throw IllegalStateException("AVL storage changed") }
        }
    }
    @OverflowWrapping
    public func clone(): OrderedMap<V> {
        let result = OrderedMap<V>(zero)
        result.root = root; result.count = count
        result.left = left.clone(); result.right = right.clone()
        result.parent = parent.clone(); result.heights = heights.clone()
        result.keys = keys.clone(); result.values = values.clone()
        result.vacant = vacant.clone()
        return result
    }
    @OverflowWrapping
    public func clear(): Unit {
        while (root != 0) { eraseNode(root) }
    }
}

// Concrete specialization; identical operations.
// One native allocation per integer AVL payload. Node IDs index fixed records:
// [left, right, parent, height, keyA, keyB, keyC, value]. Growth never renumbers
// records. A caller must end every transient borrow before addNode can grow.
public class PackedIntNodeBuffer {
    private var data: CPointer<Int64>
    private var capacity: Int64 = 16
    private var used: Int64 = 0

    public init() {
        data = LibC.malloc<Int64>(count: 128)
        if (data.isNull()) { throw IllegalMemoryException("Packed AVL allocation failed") }
    }

    ~init() { unsafe { LibC.free(data) } }

    public prop size: Int64 { get() { used } }

    @OverflowWrapping
    func borrowData(): CPointer<Int64> { data }

    @OverflowWrapping
    private func reserveForAdd(): Unit {
        if (used < capacity) { return }
        if (capacity > Int64.Max / 2) { throw IllegalMemoryException("Packed AVL capacity overflow") }
        let expandedCapacity = capacity * 2
        // Eight Int64 cells, hence 64 bytes, per node.
        if (expandedCapacity > Int64.Max / 64) { throw IllegalMemoryException("Packed AVL payload overflow") }
        let expanded = LibC.malloc<Int64>(count: expandedCapacity * 8)
        if (expanded.isNull()) { throw IllegalMemoryException("Packed AVL expansion failed") }
        unsafe {
            for (i in 0..(used * 8)) { expanded.write(i, data.read(i)) }
        }
        let previous = data
        data = expanded
        capacity = expandedCapacity
        unsafe { LibC.free(previous) }
    }

    @OverflowWrapping
    func addNode(k: Key, v: Int64, p: Int64, height: Int64): Int64 {
        reserveForAdd()
        let node = used
        let offset = node * 8
        unsafe {
            data.write(offset, 0)
            data.write(offset + 1, 0)
            data.write(offset + 2, p)
            data.write(offset + 3, height)
            data.write(offset + 4, k.a)
            data.write(offset + 5, k.b)
            data.write(offset + 6, k.c)
            data.write(offset + 7, v)
        }
        used++
        return node
    }

    @OverflowWrapping
    public func clone(): PackedIntNodeBuffer {
        let result = PackedIntNodeBuffer()
        if (capacity > result.capacity) {
            let copied = LibC.malloc<Int64>(count: capacity * 8)
            if (copied.isNull()) { throw IllegalMemoryException("Packed AVL clone allocation failed") }
            let previous = result.data
            result.data = copied
            result.capacity = capacity
            unsafe { LibC.free(previous) }
        }
        let sourceData = data
        let resultData = result.data
        unsafe {
            for (i in 0..(used * 8)) { resultData.write(i, sourceData.read(i)) }
        }
        result.used = used
        blackBox(this)
        return result
    }
}

public class IntOrderedMap {
    private let zero: Int64
    private var root: Int64 = 0
    private var count: Int64 = 0
    private var nodes = PackedIntNodeBuffer()
    // Keep exactly the previous LIFO reuse order and stable node IDs.
    private var vacant = FastIntVector()

    public init(defaultValue: Int64) {
        zero = defaultValue
        nodes.addNode(Key(0), defaultValue, 0, 0)
    }
    public prop size: Int64 { get() { count } }
    @OverflowWrapping
    public func isEmpty(): Bool { count == 0 }
    @OverflowWrapping
    public func key(node: Int64): Key {
        if (node < 0 || node >= nodes.size) { throw IndexOutOfBoundsException("AVL key index") }
        let nodeData = nodes.borrowData()
        let offset = node * 8
        let result = unsafe { Key(nodeData.read(offset + 4), nodeData.read(offset + 5), nodeData.read(offset + 6)) }
        blackBox(this)
        return result
    }
    @OverflowWrapping
    public func keyA(node: Int64): Int64 {
        if (node < 0 || node >= nodes.size) { throw IndexOutOfBoundsException("AVL key index") }
        let nodeData = nodes.borrowData()
        let result = unsafe { nodeData.read(node * 8 + 4) }
        blackBox(this)
        return result
    }
    @OverflowWrapping
    public func keyB(node: Int64): Int64 {
        if (node < 0 || node >= nodes.size) { throw IndexOutOfBoundsException("AVL key index") }
        let nodeData = nodes.borrowData()
        let result = unsafe { nodeData.read(node * 8 + 5) }
        blackBox(this)
        return result
    }
    @OverflowWrapping
    public func keyC(node: Int64): Int64 {
        if (node < 0 || node >= nodes.size) { throw IndexOutOfBoundsException("AVL key index") }
        let nodeData = nodes.borrowData()
        let result = unsafe { nodeData.read(node * 8 + 6) }
        blackBox(this)
        return result
    }
    @OverflowWrapping
    public func value(node: Int64): Int64 {
        if (node < 0 || node >= nodes.size) { throw IndexOutOfBoundsException("AVL value index") }
        let nodeData = nodes.borrowData()
        let result = unsafe { nodeData.read(node * 8 + 7) }
        blackBox(this)
        return result
    }
    @OverflowWrapping
    public func setValue(node: Int64, value: Int64): Unit {
        if (node < 0 || node >= nodes.size) { throw IndexOutOfBoundsException("AVL value index") }
        let nodeData = nodes.borrowData()
        unsafe { nodeData.write(node * 8 + 7, value) }
        blackBox(this)
    }

    // Caller must keep k strictly between the live predecessor/successor.
    // Shrinking an existing free interval preserves this order without rotations.
    @OverflowWrapping
    func setKeyValuePreservingOrder(node: Int64, k: Key, value: Int64): Unit {
        if (node < 0 || node >= nodes.size) { throw IndexOutOfBoundsException("AVL key/value index") }
        let nodeData = nodes.borrowData()
        let offset = node * 8
        unsafe {
            nodeData.write(offset + 4, k.a)
            nodeData.write(offset + 5, k.b)
            nodeData.write(offset + 6, k.c)
            nodeData.write(offset + 7, value)
        }
        blackBox(this)
    }

    @OverflowWrapping
    public func first(): Int64 {
        var node = root
        let nodeSlots = nodes.size
        if (node < 0 || node >= nodeSlots) { throw IndexOutOfBoundsException("AVL node index") }
        unsafe {
            let nodeData = nodes.borrowData()
            while (node != 0) {
                let child = nodeData.read((node) * 8)
                if (child == 0) { break }
                node = child
            }
        }
        // Public1.0.5 optimizer black box retains the strong owner use.
        blackBox(this)
        if (node < 0 || node >= this.nodes.size) { throw IndexOutOfBoundsException("AVL node index") }
        return node
    }
    @OverflowWrapping
    public func last(): Int64 {
        var node = root
        let nodeSlots = nodes.size
        if (node < 0 || node >= nodeSlots) { throw IndexOutOfBoundsException("AVL node index") }
        unsafe {
            let nodeData = nodes.borrowData()
            while (node != 0) {
                let child = nodeData.read((node) * 8 + 1)
                if (child == 0) { break }
                node = child
            }
        }
        // Public1.0.5 optimizer black box retains the strong owner use.
        blackBox(this)
        if (node < 0 || node >= this.nodes.size) { throw IndexOutOfBoundsException("AVL node index") }
        return node
    }
    @OverflowWrapping
    public func next(node: Int64): Int64 {
        if (node == 0) { return 0 }
        let nodeSlots = nodes.size
        if (node < 0 || node >= nodeSlots) { throw IndexOutOfBoundsException("AVL node index") }
        var answer: Int64 = 0
        unsafe {
            let nodeData = nodes.borrowData()
            var cur = node
            let child = nodeData.read((cur) * 8 + 1)
            if (child != 0) {
                cur = child
                while (true) {
                    let following = nodeData.read((cur) * 8)
                    if (following == 0) { break }
                    cur = following
                }
                answer = cur
            } else {
                var p = nodeData.read((cur) * 8 + 2)
                while (p != 0 && cur == nodeData.read((p) * 8 + 1)) { cur = p; p = nodeData.read((cur) * 8 + 2) }
                answer = p
            }
        }
        // Public1.0.5 optimizer black box retains the strong owner use.
        blackBox(this)
        if (answer < 0 || answer >= this.nodes.size) { throw IndexOutOfBoundsException("AVL node index") }
        return answer
    }
    @OverflowWrapping
    public func prev(node: Int64): Int64 {
        if (node == 0) { return last() }
        let nodeSlots = nodes.size
        if (node < 0 || node >= nodeSlots) { throw IndexOutOfBoundsException("AVL node index") }
        var answer: Int64 = 0
        unsafe {
            let nodeData = nodes.borrowData()
            var cur = node
            let child = nodeData.read((cur) * 8)
            if (child != 0) {
                cur = child
                while (true) {
                    let following = nodeData.read((cur) * 8 + 1)
                    if (following == 0) { break }
                    cur = following
                }
                answer = cur
            } else {
                var p = nodeData.read((cur) * 8 + 2)
                while (p != 0 && cur == nodeData.read((p) * 8)) { cur = p; p = nodeData.read((cur) * 8 + 2) }
                answer = p
            }
        }
        // Public1.0.5 optimizer black box retains the strong owner use.
        blackBox(this)
        if (answer < 0 || answer >= this.nodes.size) { throw IndexOutOfBoundsException("AVL node index") }
        return answer
    }
    @OverflowWrapping
    public func find(wanted: Key): Int64 {
        var node = root
        let nodeSlots = nodes.size
        if (node < 0 || node >= nodeSlots) { throw IndexOutOfBoundsException("AVL node index") }
        unsafe {
            let nodeData = nodes.borrowData()
            while (node != 0) {
                let offset = node * 8 + 4
                let first = nodeData.read(offset)
                var keyOrder: Int64 = 0
                if (wanted.a != first) { keyOrder = if (wanted.a < first) { -1 } else { 1 } }
                else {
                    let second = nodeData.read(offset + 1)
                    if (wanted.b != second) { keyOrder = if (wanted.b < second) { -1 } else { 1 } }
                    else {
                        let third = nodeData.read(offset + 2)
                        if (wanted.c != third) { keyOrder = if (wanted.c < third) { -1 } else { 1 } }
                    }
                }
                let order = keyOrder
                if (order == 0) { break }
                node = if (order < 0) { nodeData.read((node) * 8) } else { nodeData.read((node) * 8 + 1) }
            }
        }
        // Public1.0.5 optimizer black box retains the strong owner use.
        blackBox(this)
        if (node < 0 || node >= this.nodes.size) { throw IndexOutOfBoundsException("AVL node index") }
        return node
    }
    @OverflowWrapping
    public func lower(wanted: Key): Int64 {
        var node = root
        let nodeSlots = nodes.size
        if (node < 0 || node >= nodeSlots) { throw IndexOutOfBoundsException("AVL node index") }
        var answer: Int64 = 0
        unsafe {
            let nodeData = nodes.borrowData()
            while (node != 0) {
                let offset = node * 8 + 4
                let first = nodeData.read(offset)
                var keyOrder: Int64 = 0
                if (wanted.a != first) { keyOrder = if (wanted.a < first) { -1 } else { 1 } }
                else {
                    let second = nodeData.read(offset + 1)
                    if (wanted.b != second) { keyOrder = if (wanted.b < second) { -1 } else { 1 } }
                    else {
                        let third = nodeData.read(offset + 2)
                        if (wanted.c != third) { keyOrder = if (wanted.c < third) { -1 } else { 1 } }
                    }
                }
                let order = keyOrder
                if (order <= 0) {
                    answer = node; node = nodeData.read((node) * 8)
                } else { node = nodeData.read((node) * 8 + 1) }
            }
        }
        // Public1.0.5 optimizer black box retains the strong owner use.
        blackBox(this)
        if (answer < 0 || answer >= this.nodes.size) { throw IndexOutOfBoundsException("AVL node index") }
        return answer
    }
    @OverflowWrapping
    public func upper(wanted: Key): Int64 {
        var node = root
        let nodeSlots = nodes.size
        if (node < 0 || node >= nodeSlots) { throw IndexOutOfBoundsException("AVL node index") }
        var answer: Int64 = 0
        unsafe {
            let nodeData = nodes.borrowData()
            while (node != 0) {
                let offset = node * 8 + 4
                let first = nodeData.read(offset)
                var keyOrder: Int64 = 0
                if (wanted.a != first) { keyOrder = if (wanted.a < first) { -1 } else { 1 } }
                else {
                    let second = nodeData.read(offset + 1)
                    if (wanted.b != second) { keyOrder = if (wanted.b < second) { -1 } else { 1 } }
                    else {
                        let third = nodeData.read(offset + 2)
                        if (wanted.c != third) { keyOrder = if (wanted.c < third) { -1 } else { 1 } }
                    }
                }
                let order = keyOrder
                if (order < 0) {
                    answer = node; node = nodeData.read((node) * 8)
                } else { node = nodeData.read((node) * 8 + 1) }
            }
        }
        // Public1.0.5 optimizer black box retains the strong owner use.
        blackBox(this)
        if (answer < 0 || answer >= this.nodes.size) { throw IndexOutOfBoundsException("AVL node index") }
        return answer
    }
    @OverflowWrapping
    private func fixHeight(node: Int64): Unit {
        let allocated = nodes.size
        if (node < 0 || node >= allocated) { throw IndexOutOfBoundsException("AVL node") }
        let nodeData = nodes.borrowData()
        unsafe {
            nodeData.write((node) * 8 + 3, 1 + iMax(nodeData.read((nodeData.read((node) * 8)) * 8 + 3), nodeData.read((nodeData.read((node) * 8 + 1)) * 8 + 3)))
        
            // No helper below resizes this packed buffer. The owner check
            // after the final pointer use keeps all buffers reachable.
            blackBox(this)
            if (nodes.size != allocated) { throw IllegalStateException("AVL storage changed") }
        }
    }
    @OverflowWrapping
    private func replaceAtParent(oldNode: Int64, newNode: Int64): Unit {
        let allocated = nodes.size
        if (oldNode < 0 || oldNode >= allocated || newNode < 0 || newNode >= allocated) { throw IndexOutOfBoundsException("AVL node") }
        let nodeData = nodes.borrowData()
        unsafe {
            let p = nodeData.read((oldNode) * 8 + 2)
            if (p == 0) { root = newNode }
            else if (nodeData.read((p) * 8) == oldNode) { nodeData.write((p) * 8, newNode) }
            else { nodeData.write((p) * 8 + 1, newNode) }
            if (newNode != 0) { nodeData.write((newNode) * 8 + 2, p) }
        
            // No helper below resizes this packed buffer. The owner check
            // after the final pointer use keeps all buffers reachable.
            blackBox(this)
            if (nodes.size != allocated) { throw IllegalStateException("AVL storage changed") }
        }
    }
    @OverflowWrapping
    private func rotateLeft(node: Int64): Int64 {
        let allocated = nodes.size
        if (node < 0 || node >= allocated) { throw IndexOutOfBoundsException("AVL node") }
        let nodeData = nodes.borrowData()
        unsafe {
            let top = nodeData.read((node) * 8 + 1)
            let middle = nodeData.read((top) * 8)
            let rotationParent = nodeData.read((node) * 8 + 2)
            if (rotationParent == 0) { root = top }
            else if (nodeData.read((rotationParent) * 8) == node) { nodeData.write((rotationParent) * 8, top) }
            else { nodeData.write((rotationParent) * 8 + 1, top) }
            if (top != 0) { nodeData.write((top) * 8 + 2, rotationParent) }
            nodeData.write((top) * 8, node); nodeData.write((node) * 8 + 2, top)
            nodeData.write((node) * 8 + 1, middle)
            if (middle != 0) { nodeData.write((middle) * 8 + 2, node) }
            nodeData.write((node) * 8 + 3, 1 + iMax(nodeData.read((nodeData.read((node) * 8)) * 8 + 3), nodeData.read((nodeData.read((node) * 8 + 1)) * 8 + 3)))
            nodeData.write((top) * 8 + 3, 1 + iMax(nodeData.read((nodeData.read((top) * 8)) * 8 + 3), nodeData.read((nodeData.read((top) * 8 + 1)) * 8 + 3)))
            // No helper below resizes this packed buffer. The owner check
            // after the final pointer use keeps all buffers reachable.
            blackBox(this)
            if (nodes.size != allocated) { throw IllegalStateException("AVL storage changed") }
            return top
        }
    }
    @OverflowWrapping
    private func rotateRight(node: Int64): Int64 {
        let allocated = nodes.size
        if (node < 0 || node >= allocated) { throw IndexOutOfBoundsException("AVL node") }
        let nodeData = nodes.borrowData()
        unsafe {
            let top = nodeData.read((node) * 8)
            let middle = nodeData.read((top) * 8 + 1)
            let rotationParent = nodeData.read((node) * 8 + 2)
            if (rotationParent == 0) { root = top }
            else if (nodeData.read((rotationParent) * 8) == node) { nodeData.write((rotationParent) * 8, top) }
            else { nodeData.write((rotationParent) * 8 + 1, top) }
            if (top != 0) { nodeData.write((top) * 8 + 2, rotationParent) }
            nodeData.write((top) * 8 + 1, node); nodeData.write((node) * 8 + 2, top)
            nodeData.write((node) * 8, middle)
            if (middle != 0) { nodeData.write((middle) * 8 + 2, node) }
            nodeData.write((node) * 8 + 3, 1 + iMax(nodeData.read((nodeData.read((node) * 8)) * 8 + 3), nodeData.read((nodeData.read((node) * 8 + 1)) * 8 + 3)))
            nodeData.write((top) * 8 + 3, 1 + iMax(nodeData.read((nodeData.read((top) * 8)) * 8 + 3), nodeData.read((nodeData.read((top) * 8 + 1)) * 8 + 3)))
            // No helper below resizes this packed buffer. The owner check
            // after the final pointer use keeps all buffers reachable.
            blackBox(this)
            if (nodes.size != allocated) { throw IllegalStateException("AVL storage changed") }
            return top
        }
    }
    @OverflowWrapping
    private func rebalance(start: Int64): Unit {
        if (start == 0) { return }
        let allocated = nodes.size
        if (start < 0 || start >= allocated) { throw IndexOutOfBoundsException("AVL node") }
        let nodeData = nodes.borrowData()
        unsafe {
            var node = start
            while (node != 0) {
                let oldHeight = nodeData.read((node) * 8 + 3)
                nodeData.write((node) * 8 + 3, 1 + iMax(nodeData.read((nodeData.read((node) * 8)) * 8 + 3), nodeData.read((nodeData.read((node) * 8 + 1)) * 8 + 3)))
                let balance = nodeData.read((nodeData.read((node) * 8)) * 8 + 3) - nodeData.read((nodeData.read((node) * 8 + 1)) * 8 + 3)
                if (balance > 1) {
                    let child = nodeData.read((node) * 8)
                    if (nodeData.read((nodeData.read((child) * 8)) * 8 + 3) < nodeData.read((nodeData.read((child) * 8 + 1)) * 8 + 3)) { rotateLeft(child) }
                    node = rotateRight(node)
                } else if (balance < -1) {
                    let child = nodeData.read((node) * 8 + 1)
                    if (nodeData.read((nodeData.read((child) * 8 + 1)) * 8 + 3) < nodeData.read((nodeData.read((child) * 8)) * 8 + 3)) { rotateRight(child) }
                    node = rotateLeft(node)
                }
                // The repaired subtree has the same height as before the
                // mutation. Ancestors retain their heights and balances.
                if (nodeData.read((node) * 8 + 3) == oldHeight) { break }
                node = nodeData.read((node) * 8 + 2)
            }
        
            // No helper below resizes this packed buffer. The owner check
            // after the final pointer use keeps all buffers reachable.
            blackBox(this)
            if (nodes.size != allocated) { throw IllegalStateException("AVL storage changed") }
        }
    }
    @OverflowWrapping
    private func newNode(k: Key, v: Int64, p: Int64): Int64 {
        var node: Int64
        if (vacant.size > 0) {
            node = vacant.remove(at: vacant.size - 1)
            if (node < 0 || node >= nodes.size) { throw IndexOutOfBoundsException("AVL node") }
            let nodeData = nodes.borrowData()
            let offset = node * 8
            unsafe {
                nodeData.write(offset, 0)
                nodeData.write(offset + 1, 0)
                nodeData.write(offset + 2, p)
                nodeData.write(offset + 3, 1)
                nodeData.write(offset + 4, k.a)
                nodeData.write(offset + 5, k.b)
                nodeData.write(offset + 6, k.c)
                nodeData.write(offset + 7, v)
            }
            blackBox(this)
        } else {
            // addNode may replace the native allocation; no borrow is live.
            node = nodes.addNode(k, v, p, 1)
        }
        count++
        return node
    }
    @OverflowWrapping
    public func put(k: Key, v: Int64): Int64 {
        var node = root
        var p: Int64 = 0
        var order: Int64 = 0
        let nodeSlots = nodes.size
        if (node < 0 || node >= nodeSlots) { throw IndexOutOfBoundsException("AVL node index") }
        // Search and an existing-node value write never grow this allocation.
        // End this borrow before newNode can append and replace the buffer.
        unsafe {
            let nodeData = nodes.borrowData()
            while (node != 0) {
                let offset = node * 8 + 4
                let first = nodeData.read(offset)
                var keyOrder: Int64 = 0
                if (k.a != first) { keyOrder = if (k.a < first) { -1 } else { 1 } }
                else {
                    let second = nodeData.read(offset + 1)
                    if (k.b != second) { keyOrder = if (k.b < second) { -1 } else { 1 } }
                    else {
                        let third = nodeData.read(offset + 2)
                        if (k.c != third) { keyOrder = if (k.c < third) { -1 } else { 1 } }
                    }
                }
                order = keyOrder
                if (order == 0) { break }
                p = node
                node = if (order < 0) { nodeData.read(node * 8) } else { nodeData.read(node * 8 + 1) }
            }
            if (node != 0) { nodeData.write(node * 8 + 7, v) }
        }
        blackBox(this)
        if (node != 0) { return node }
        let added = newNode(k, v, p)
        if (p == 0) { root = added }
        else {
            // Reborrow after append; the preceding search pointer has expired.
            let nodeData = nodes.borrowData()
            unsafe {
                if (order < 0) { nodeData.write(p * 8, added) }
                else { nodeData.write(p * 8 + 1, added) }
            }
            blackBox(this)
        }
        rebalance(p)
        return added
    }
    @OverflowWrapping
    public func eraseKey(k: Key): Unit {
        let node = find(k)
        if (node != 0) { eraseNode(node) }
    }
    @OverflowWrapping
    public func eraseNode(node: Int64): Unit {
        if (node == 0) { return }
        let allocated = nodes.size
        if (node < 0 || node >= allocated) { throw IndexOutOfBoundsException("AVL node") }
        let nodeData = nodes.borrowData()
        unsafe {
            var repair: Int64
            if (nodeData.read((node) * 8) == 0 || nodeData.read((node) * 8 + 1) == 0) {
                repair = nodeData.read((node) * 8 + 2)
                let child = if (nodeData.read((node) * 8) != 0) { nodeData.read((node) * 8) } else { nodeData.read((node) * 8 + 1) }
                replaceAtParent(node, child)
            } else {
                var successor = nodeData.read((node) * 8 + 1)
                while (nodeData.read((successor) * 8) != 0) { successor = nodeData.read((successor) * 8) }
                if (nodeData.read((successor) * 8 + 2) != node) {
                    repair = nodeData.read((successor) * 8 + 2)
                    replaceAtParent(successor, nodeData.read((successor) * 8 + 1))
                    nodeData.write((successor) * 8 + 1, nodeData.read((node) * 8 + 1))
                    nodeData.write((nodeData.read((successor) * 8 + 1)) * 8 + 2, successor)
                } else { repair = successor }
                replaceAtParent(node, successor)
                nodeData.write((successor) * 8, nodeData.read((node) * 8))
                nodeData.write((nodeData.read((successor) * 8)) * 8 + 2, successor)
                nodeData.write((successor) * 8 + 3, nodeData.read((node) * 8 + 3))
            }
            nodeData.write((node) * 8, 0); nodeData.write((node) * 8 + 1, 0); nodeData.write((node) * 8 + 2, 0); nodeData.write((node) * 8 + 3, 0)
            nodeData.write(node * 8 + 7, zero)
            vacant.add(node); count--
            rebalance(repair)
        
            // No helper below resizes this packed buffer. The owner check
            // after the final pointer use keeps all buffers reachable.
            blackBox(this)
            if (nodes.size != allocated) { throw IllegalStateException("AVL storage changed") }
        }
    }
    @OverflowWrapping
    public func clone(): IntOrderedMap {
        let result = IntOrderedMap(zero)
        result.root = root; result.count = count
        result.nodes = nodes.clone()
        result.vacant = vacant.clone()
        return result
    }
    @OverflowWrapping
    public func clear(): Unit {
        while (root != 0) { eraseNode(root) }
    }
}

public class Ring<T> {
    private let zero: T
    private var data: Array<T>
    private var head: Int64 = 0
    private var count: Int64 = 0
    public init(defaultValue: T) {
        zero = defaultValue
        data = Array<T>(16, { _ => defaultValue })
    }
    public prop size: Int64 { get() { count } }
    @OverflowWrapping
    public func get(index: Int64): T { data[(head + index) % data.size] }
    @OverflowWrapping
    public func back(): T { get(count - 1) }
    @OverflowWrapping
    public func pushBack(value: T): Unit {
        if (count == data.size) {
            let expanded = Array<T>(data.size * 2, { _ => zero })
            for (i in 0..count) { expanded[i] = get(i) }
            data = expanded; head = 0
        }
        data[(head + count) % data.size] = value
        count++
    }
    @OverflowWrapping
    public func popFront(): Unit {
        data[head] = zero
        head = (head + 1) % data.size
        count--
    }
    @OverflowWrapping
    public func popBack(): Unit {
        count--; data[(head + count) % data.size] = zero
    }
    @OverflowWrapping
    public func clone(): Ring<T> {
        let result = Ring<T>(zero)
        for (i in 0..count) { result.pushBack(get(i)) }
        return result
    }
}

// Concrete specialization; identical operations.
public class IntRing {
    private let zero: Int64
    private var data: Array<Int64>
    private var head: Int64 = 0
    private var count: Int64 = 0
    public init(defaultValue: Int64) {
        zero = defaultValue
        data = Array<Int64>(16, { _ => defaultValue })
    }
    public prop size: Int64 { get() { count } }
    @OverflowWrapping
    public func get(index: Int64): Int64 { data[(head + index) % data.size] }
    @OverflowWrapping
    public func back(): Int64 { get(count - 1) }
    @OverflowWrapping
    public func pushBack(value: Int64): Unit {
        if (count == data.size) {
            let expanded = Array<Int64>(data.size * 2, { _ => zero })
            for (i in 0..count) { expanded[i] = get(i) }
            data = expanded; head = 0
        }
        data[(head + count) % data.size] = value
        count++
    }
    @OverflowWrapping
    public func popFront(): Unit {
        data[head] = zero
        head = (head + 1) % data.size
        count--
    }
    @OverflowWrapping
    public func popBack(): Unit {
        count--; data[(head + count) % data.size] = zero
    }
    @OverflowWrapping
    public func clone(): IntRing {
        let result = IntRing(zero)
        // Copy Int64 values into independent backing storage; preserve ring order.
        result.data = data.clone()
        result.head = head
        result.count = count
        return result
    }
}

// The ring stores the exact current window. Scalar counters retain the
// full last three pushed runs; runCount clips them to the current suffix size.
public class LengthHistory {
    private let zero: Int64
    private var data: IntRing
    private var length0: Int64 = 0
    private var length1: Int64 = 0
    private var length2: Int64 = 0
    private var count0: Int64 = 0
    private var count1: Int64 = 0
    private var count2: Int64 = 0

    public init(defaultValue: Int64) { zero = defaultValue; data = IntRing(defaultValue) }
    public prop size: Int64 { get() { data.size } }
    @OverflowWrapping
    public func get(index: Int64): Int64 { data.get(index) }
    @OverflowWrapping
    public func back(): Int64 { data.back() }

    @OverflowWrapping
    public func runLength(index: Int64): Int64 {
        if (index == 0) { return length0 }
        if (index == 1) { return length1 }
        if (index == 2) { return length2 }
        throw IndexOutOfBoundsException("Length run index")
    }

    @OverflowWrapping
    public func runCount(index: Int64): Int64 {
        let newest = iMin(count0, data.size)
        if (index == 0) { return newest }
        let second = iMin(count1, data.size - newest)
        if (index == 1) { return second }
        if (index == 2) { return iMin(count2, data.size - newest - second) }
        throw IndexOutOfBoundsException("Length run index")
    }

    @OverflowWrapping
    public func pushBack(value: Int64): Unit {
        // Mutate the ring first, so a failed ring expansion cannot alter cache.
        data.pushBack(value)
        if (data.size == 1) {
            length0 = value; count0 = 1
            length1 = 0; count1 = 0; length2 = 0; count2 = 0
        } else if (value == length0) { count0++ }
        else {
            length2 = length1; count2 = count1
            length1 = length0; count1 = count0
            length0 = value; count0 = 1
        }
    }

    @OverflowWrapping
    public func popFront(): Unit {
        data.popFront()
        // Otherwise clipping by current size handles all front deletions.
        if (data.size == 0) {
            length0 = 0; length1 = 0; length2 = 0
            count0 = 0; count1 = 0; count2 = 0
        }
    }

    // No current recentLengths callsite uses popBack. Keep exact API semantics
    // with a rare fallback scan, because removing a newest run can expose run4.
    @OverflowWrapping
    public func popBack(): Unit {
        data.popBack()
        length0 = 0; length1 = 0; length2 = 0
        count0 = 0; count1 = 0; count2 = 0
        var index = data.size - 1
        for (run in 0..3) {
            if (index < 0) { break }
            let value = data.get(index)
            var count: Int64 = 0
            while (index >= 0 && data.get(index) == value) { count++; index-- }
            if (run == 0) { length0 = value; count0 = count }
            else if (run == 1) { length1 = value; count1 = count }
            else { length2 = value; count2 = count }
        }
    }

    @OverflowWrapping
    public func clone(): LengthHistory {
        let result = LengthHistory(zero)
        result.data = data.clone()
        result.length0 = length0; result.length1 = length1; result.length2 = length2
        result.count0 = count0; result.count1 = count1; result.count2 = count2
        return result
    }
}

// Source: models.cj
public let kDigLength: Int64 = 20
public let kHistoryWindow: Int64 = 2048
public let kUnfitPenaltyScale: Int64 = 60
public let kPrimalGapValueCap: Int64 = 512
public let kRightEdgeMaxPipeLength: Int64 = 4
public let kSameLengthRightRun: Int64 = 46
public let kMcHistory: Int64 = 256
public let kMcDepth: Int64 = 4
public let kMcTrials: Int64 = 12
public let kMcDecisionBudget: Int64 = 32
public let kMcMaxGaps: Int64 = 64
public let kMcMaxActivePipes: Int64 = 4096
public let kMcMinimumMeanSavingM: Int64 = 1

