public class CensoredLifetimeModel {
    private var recordBorn = FastIntVector()
    private var recordLength = FastIntVector()
    private var recordActive = FastIntVector()
    // No managed references in these numeric buffers; they never resize.
    private let cells = FastIntBuffer(1312)
    private let rates = FastFloatBuffer(656)
    private let nextCrossing = FastIntBuffer(8)
    private let lower = FastIntBuffer(8)
    private var clock: Int64 = 0
    private var lastFlushedClock: Int64 = 0
    private var referenceRate: Float64 = 0.0
    private var referenceError: Float64 = 0.0
    private var fitted: Bool = false

    public init() {
        recordBorn.add(0); recordLength.add(0); recordActive.add(0)
        for (i in 0..8) { nextCrossing[i] = 1 }
        lower[0] = 0; lower[1] = 16; lower[2] = 64; lower[3] = 256
        lower[4] = 1024; lower[5] = 4096; lower[6] = 16384; lower[7] = 65536
    }

    private func ageBin(age: Int64): Int64 {
        if (age < 1024) {
            if (age < 64) { return if (age < 16) { 0 } else { 1 } }
            return if (age < 256) { 2 } else { 3 }
        }
        if (age < 16384) { return if (age < 4096) { 4 } else { 5 } }
        return if (age < 65536) { 6 } else { 7 }
    }

    @OverflowWrapping
    private func predict(length: Int64, initialAge: Int64): LifetimeEstimate {
        var result = LifetimeEstimate()
        var age = initialAge
        let end = age + kHistoryWindow
        var bin = ageBin(age)
        let limits = lower.borrowData()
        let rateData = rates.borrowData()
        unsafe {
            while (age < end) {
                let next = if (bin + 1 < 8) { iMin(end, limits.read(bin + 1)) } else { end }
                let weight = Float64(next - age) / Float64(kHistoryWindow)
                let index = (length * 8 + bin) * 2
                result.mean += weight * rateData.read(index)
                result.error += weight * rateData.read(index + 1)
                age = next
                if (age < end) { bin++ }
            }
        }
        blackBox(this)
        return result
    }

    private func adjustedRatio(length: Int64, age: Int64): Float64 {
        if (!fitted) { return 1.0 }
        let prediction = predict(length, age)
        let margin = 2.0 * (prediction.error + referenceError)
        var supported = referenceRate
        if (prediction.mean - margin > referenceRate) { supported = prediction.mean - margin }
        else if (prediction.mean + margin < referenceRate) { supported = prediction.mean + margin }
        return fMin(fMax(supported / referenceRate, 0.5), 2.0)
    }

    @OverflowWrapping
    public func advance(): Unit { clock++ }

    // Cells are observed only by fit. Keep their stored bin at the previous
    // flush; a deletion advances its own record before removing it.
    @OverflowWrapping
    private func flushCrossings(): Unit {
        let born = recordBorn.borrowData()
        let length = recordLength.borrowData()
        let active = recordActive.borrowData()
        let count = recordBorn.size
        let crossing = nextCrossing.borrowData()
        let limits = lower.borrowData()
        let cellData = cells.borrowData()
        unsafe {
            for (bin in 1..8) {
                var cursor = crossing.read(bin)
                let threshold = limits.read(bin)
                while (cursor < count && clock - born.read(cursor) >= threshold) {
                    let birth = born.read(cursor)
                    let size = length.read(cursor)
                    let alive = active.read(cursor)
                    cursor++
                    if (alive == 0) { continue }
                    let previous = (size * 8 + bin - 1) * 4
                    cellData.write(previous, cellData.read(previous) + threshold - limits.read(bin - 1))
                    cellData.write(previous + 2, cellData.read(previous + 2) - 1)
                    cellData.write(previous + 1, cellData.read(previous + 1) - birth)
                    let current = (size * 8 + bin) * 4
                    cellData.write(current + 2, cellData.read(current + 2) + 1)
                    cellData.write(current + 1, cellData.read(current + 1) + birth)
                }
                crossing.write(bin, cursor)
            }
        }
        lastFlushedClock = clock
        blackBox(this)
    }

    @OverflowWrapping
    public func observeBirth(length: Int64): Unit {
        recordBorn.add(clock); recordLength.add(length); recordActive.add(1)
        let cellData = cells.borrowData()
        let index = length * 8 * 4
        unsafe {
            cellData.write(index + 2, cellData.read(index + 2) + 1)
            cellData.write(index + 1, cellData.read(index + 1) + clock)
        }
        blackBox(this)
    }

    @OverflowWrapping
    public func observeDeletion(pid: Int64): Unit {
        let birth = recordBorn[pid]
        let length = recordLength[pid]
        let age = clock - birth
        let bin = ageBin(age)
        let index = (length * 8 + bin) * 4
        let cellData = cells.borrowData()
        let limits = lower.borrowData()
        // An active record was in its true bin at lastFlushedClock, or was
        // born in bin zero after that flush. Catch up only this record.
        var pendingBin = ageBin(iMax(0, lastFlushedClock - birth))
        unsafe {
            while (pendingBin < bin) {
                let previous = (length * 8 + pendingBin) * 4
                let current = previous + 4
                let boundary = limits.read(pendingBin + 1)
                cellData.write(previous, cellData.read(previous) + boundary - limits.read(pendingBin))
                cellData.write(previous + 2, cellData.read(previous + 2) - 1)
                cellData.write(previous + 1, cellData.read(previous + 1) - birth)
                cellData.write(current + 2, cellData.read(current + 2) + 1)
                cellData.write(current + 1, cellData.read(current + 1) + birth)
                pendingBin++
            }
            cellData.write(index, cellData.read(index) + age - limits.read(bin))
            cellData.write(index + 2, cellData.read(index + 2) - 1)
            cellData.write(index + 1, cellData.read(index + 1) - birth)
            let eventBin = ageBin(if (age == 0) { 0 } else { age - 1 })
            let eventIndex = (length * 8 + eventBin) * 4 + 3
            cellData.write(eventIndex, cellData.read(eventIndex) + 1)
        }
        recordActive[pid] = 0
        blackBox(this)
    }

    @OverflowWrapping
    public func fit(priorHazard: Float64): Bool {
        // Also flush on the early-return path, so every fit sees exactly the
        // eager model's integer cells at this clock.
        flushCrossings()
        fitted = false
        if (!(priorHazard > 0.0)) { return false }
        let priorEvents: Float64 = 8.0
        let cellData = cells.borrowData()
        let rateData = rates.borrowData()
        let limits = lower.borrowData()
        unsafe {
            for (bin in 0..8) {
                let fitBinLower = limits.read(bin)
                var pooledExposure: Float64 = 0.0
                var pooledDeaths: Float64 = 0.0
                for (length in 1..41) {
                    let index = (length * 8 + bin) * 4
                    let active = cellData.read(index + 2)
                    let fitOutstanding: Int64 = if (active == 0) { 0 } else { active * (clock - fitBinLower) - cellData.read(index + 1) }
                    let fitExposure = cellData.read(index) + fitOutstanding
                    pooledExposure += Float64(fitExposure)
                    pooledDeaths += Float64(cellData.read(index + 3))
                }
                let pooledDenominator = pooledExposure + priorEvents / priorHazard
                let pooledRate = (pooledDeaths + priorEvents) / pooledDenominator
                let pooledError = sqrt(pooledDeaths + priorEvents) / pooledDenominator
                let borrowedExposure = priorEvents / pooledRate
                for (length in 1..41) {
                    let index = (length * 8 + bin) * 4
                    let active = cellData.read(index + 2)
                    let fitOutstanding: Int64 = if (active == 0) { 0 } else { active * (clock - fitBinLower) - cellData.read(index + 1) }
                    let fitExposure = cellData.read(index) + fitOutstanding
                    let denominator = Float64(fitExposure) + borrowedExposure
                    let shape = Float64(cellData.read(index + 3)) + priorEvents
                    let rateIndex = (length * 8 + bin) * 2
                    rateData.write(rateIndex, shape / denominator)
                    rateData.write(rateIndex + 1, sqrt(shape) / denominator + borrowedExposure / denominator * pooledError)
                }
            }
        }
        var sumRate: Float64 = 0.0
        var sumError: Float64 = 0.0
        var population: Int64 = 0
        unsafe {
            for (length in 1..41) {
                for (bin in 0..8) {
                    let index = (length * 8 + bin) * 4
                    let active = cellData.read(index + 2)
                    if (active == 0) { continue }
                    let meanAge = clock - cellData.read(index + 1) / active
                    let prediction = predict(length, meanAge)
                    sumRate += Float64(active) * prediction.mean
                    sumError += Float64(active) * prediction.error
                    population += active
                }
            }
        }
        blackBox(this)
        if (population == 0) { return false }
        referenceRate = sumRate / Float64(population)
        referenceError = sumError / Float64(population)
        fitted = referenceRate > 0.0
        return fitted
    }

    public func existingRisk(pid: Int64): Float64 {
        return adjustedRatio(recordLength[pid], clock - recordBorn[pid])
    }
    public func newRisk(length: Int64): Float64 { return adjustedRatio(length, 0) }
}

// Fixed-capacity owner of stdlib malloc memory. No managed references
// are stored in its payload; Cangjie GC never relocates this C-heap memory.
// Local aliases borrow this class instance. Ownership is never copied.
// Fixed-size native Int64 owner. No raw pointer export or ownership copy.
public class FastIntBuffer {
    private let data: CPointer<Int64>
    public let size: Int64

    public init(capacity: Int64) {
        if (capacity <= 0) { throw IllegalArgumentException("Invalid integer buffer capacity") }
        this.size = capacity
        this.data = LibC.malloc<Int64>(count: capacity)
        if (data.isNull()) { throw IllegalMemoryException("Integer buffer allocation failed") }
        unsafe {
            for (i in 0..capacity) { data.write(i, 0) }
        }
    }

    ~init() { unsafe { LibC.free(data) } }

    func borrowData(): CPointer<Int64> { data }

    public operator func [](index: Int64): Int64 {
        if (index < 0 || index >= size) { throw IndexOutOfBoundsException("Integer buffer index") }
        return unsafe { data.read(index) }
    }

    public operator func [](index: Int64, value!: Int64): Unit {
        if (index < 0 || index >= size) { throw IndexOutOfBoundsException("Integer buffer index") }
        unsafe { data.write(index, value) }
    }
}

public class FastFloatBuffer {
    private let data: CPointer<Float64>
    public let size: Int64

    public init(capacity: Int64) {
        if (capacity <= 0) { throw IllegalArgumentException("Invalid numeric buffer capacity") }
        this.size = capacity
        this.data = LibC.malloc<Float64>(count: capacity)
        if (data.isNull()) { throw IllegalMemoryException("Numeric buffer allocation failed") }
        unsafe {
            for (i in 0..capacity) { data.write(i, 0.0) }
        }
    }

    // Official1.0.5 finalizer syntax. No instance method calls, allocation,
    // synchronization or potentially throwing arithmetic in this body.
    ~init() {
        unsafe { LibC.free(data) }
    }

    public operator func [](index: Int64): Float64 {
        if (index < 0 || index >= size) { throw IndexOutOfBoundsException("Numeric buffer index") }
        return unsafe { data.read(index) }
    }

    public operator func [](index: Int64, value!: Float64): Unit {
        if (index < 0 || index >= size) { throw IndexOutOfBoundsException("Numeric buffer index") }
        unsafe { data.write(index, value) }
    }

    public func fill(value: Float64): Unit {
        unsafe {
            for (i in 0..size) { data.write(i, value) }
        }
    }

    // Borrow only while the owning Allocator remains live. The native
    // allocation is fixed-size and cannot move during Cangjie GC.
    func borrowData(): CPointer<Float64> { data }

    public func copyFrom(other: FastFloatBuffer): Unit {
        if (other.size != size) { throw IllegalArgumentException("Numeric buffer copy size") }
        unsafe {
            for (i in 0..size) { data.write(i, other.data.read(i)) }
        }
    }
}

// Native storage owned by one object; growth releases old memory immediately.
public class BoundaryInt32Vector {
    private var data: CPointer<Int32>
    private var capacity: Int64 = 16
    private var used: Int64 = 0
    public init() {
        data = LibC.malloc<Int32>(count: 16)
        if (data.isNull()) { throw IllegalMemoryException("Boundary vector allocation") }
    }
    ~init() { unsafe { LibC.free(data) } }
    public prop size: Int64 { get() { used } }
    @OverflowWrapping
    public operator func [](index: Int64): Int32 {
        if (index < 0 || index >= used) { throw IndexOutOfBoundsException("Boundary vector index") }
        return unsafe { data.read(index) }
    }
    @OverflowWrapping
    public operator func [](index: Int64, value!: Int32): Unit {
        if (index < 0 || index >= used) { throw IndexOutOfBoundsException("Boundary vector index") }
        unsafe { data.write(index, value) }
    }
    @OverflowWrapping
    public func add(value: Int32): Unit {
        if (used == capacity) {
            let nextCapacity = capacity * 2
            if (nextCapacity > 262144) { throw IllegalMemoryException("Boundary vector cap") }
            let expanded = LibC.malloc<Int32>(count: nextCapacity)
            if (expanded.isNull()) { throw IllegalMemoryException("Boundary vector expansion") }
            unsafe { for (i in 0..used) { expanded.write(i, data.read(i)) } }
            let previous = data
            data = expanded
            capacity = nextCapacity
            unsafe { LibC.free(previous) }
        }
        unsafe { data.write(used, value) }
        used++
    }
    @OverflowWrapping
    public func removeLast(): Int32 {
        if (used == 0) { throw IndexOutOfBoundsException("Boundary vector empty") }
        used--
        return unsafe { data.read(used) }
    }
}

public class BoundaryIndex {
    private var data: CPointer<Int32>
    private var capacity: Int64 = 16
    private var occupied: Int64 = 0
    private let active = BoundaryInt32Vector()
    private let position = BoundaryInt32Vector()
    public init() {
        data = LibC.malloc<Int32>(count: 48)
        if (data.isNull()) { throw IllegalMemoryException("Boundary hash allocation") }
        unsafe { for (i in 0..48) { data.write(i, Int32(0)) } }
        position.add(Int32(-1))
    }
    ~init() { unsafe { LibC.free(data) } }
    public prop activeCount: Int64 { get() { active.size } }
    @OverflowWrapping
    private func home(coordinate: Int64, mask: Int64): Int64 {
        var word = UInt32(coordinate)
        word = (word ^ (word >> 16)) * UInt32(0x7feb352d)
        word = (word ^ (word >> 15)) * UInt32(0x846ca68b)
        word = word ^ (word >> 16)
        return Int64(word & UInt32(mask))
    }
    @OverflowWrapping
    private func slot(coordinate: Int64): Int64 {
        let mask = capacity - 1
        var index = home(coordinate, mask)
        let wanted = Int32(coordinate + 1)
        unsafe {
            while (true) {
                let key = data.read(index * 3)
                if (key == 0 || key == wanted) { break }
                index = (index + 1) & mask
            }
        }
        blackBox(this)
        return index
    }
    @OverflowWrapping
    private func grow(): Unit {
        let nextCapacity = capacity * 2
        if (nextCapacity > 1048576) { throw IllegalMemoryException("Boundary hash cap") }
        let expanded = LibC.malloc<Int32>(count: nextCapacity * 3)
        if (expanded.isNull()) { throw IllegalMemoryException("Boundary hash expansion") }
        unsafe {
            for (i in 0..(nextCapacity * 3)) { expanded.write(i, Int32(0)) }
            let mask = nextCapacity - 1
            for (i in 0..capacity) {
                let key = data.read(i * 3)
                if (key == 0) { continue }
                var target = home(Int64(key) - 1, mask)
                while (expanded.read(target * 3) != 0) { target = (target + 1) & mask }
                expanded.write(target * 3, key)
                expanded.write(target * 3 + 1, data.read(i * 3 + 1))
                expanded.write(target * 3 + 2, data.read(i * 3 + 2))
            }
        }
        let previous = data
        data = expanded
        capacity = nextCapacity
        unsafe { LibC.free(previous) }
        blackBox(this)
    }
    @OverflowWrapping
    private func putBoundary(coordinate: Int64, pid: Int64, role: Int64): Unit {
        if (coordinate < 0 || coordinate > 100000000 || pid <= 0 || pid > 200000) { throw IllegalArgumentException("Boundary domain") }
        var index = slot(coordinate)
        var key = unsafe { data.read(index * 3) }
        if (key == 0 && (occupied + 1) * 2 > capacity) {
            grow()
            index = slot(coordinate)
            key = unsafe { data.read(index * 3) }
        }
        unsafe {
            if (key == 0) {
                data.write(index * 3, Int32(coordinate + 1))
                data.write(index * 3 + 1, Int32(0))
                data.write(index * 3 + 2, Int32(0))
                occupied++
            }
            let previous = data.read(index * 3 + role)
            if (previous != 0) { throw IllegalStateException("Duplicate active endpoint role") }
            data.write(index * 3 + role, Int32(pid))
        }
        blackBox(this)
    }
    @OverflowWrapping
    private func eraseBoundary(coordinate: Int64, pid: Int64, role: Int64): Unit {
        let index = slot(coordinate)
        let mask = capacity - 1
        unsafe {
            if (data.read(index * 3) == 0 || data.read(index * 3 + role) != Int32(pid)) { throw IllegalStateException("Missing endpoint role") }
            data.write(index * 3 + role, Int32(0))
            if (data.read(index * 3 + 1) == 0 && data.read(index * 3 + 2) == 0) {
                var hole = index
                var scan = (hole + 1) & mask
                while (data.read(scan * 3) != 0) {
                    let key = data.read(scan * 3)
                    let origin = home(Int64(key) - 1, mask)
                    if (((scan - origin) & mask) >= ((scan - hole) & mask)) {
                        data.write(hole * 3, key)
                        data.write(hole * 3 + 1, data.read(scan * 3 + 1))
                        data.write(hole * 3 + 2, data.read(scan * 3 + 2))
                        hole = scan
                    }
                    scan = (scan + 1) & mask
                }
                data.write(hole * 3, Int32(0))
                data.write(hole * 3 + 1, Int32(0))
                data.write(hole * 3 + 2, Int32(0))
                occupied--
            }
        }
        blackBox(this)
    }
    @OverflowWrapping
    public func startingAt(coordinate: Int64): Int64 {
        let index = slot(coordinate)
        let result = unsafe { Int64(data.read(index * 3 + 1)) }
        blackBox(this)
        return result
    }
    @OverflowWrapping
    public func endingAt(coordinate: Int64): Int64 {
        let index = slot(coordinate)
        let result = unsafe { Int64(data.read(index * 3 + 2)) }
        blackBox(this)
        return result
    }
    @OverflowWrapping
    public func addPipe(pid: Int64, start: Int64, length: Int64): Unit {
        if (pid != position.size || length <= 0 || length > 40) { throw IllegalStateException("Boundary birth sequence") }
        putBoundary(start, pid, 1)
        putBoundary(start + length, pid, 2)
        position.add(Int32(active.size))
        active.add(Int32(pid))
    }
    @OverflowWrapping
    public func removePipe(pid: Int64, start: Int64, length: Int64): Unit {
        let index = Int64(position[pid])
        if (index < 0 || Int64(active[index]) != pid) { throw IllegalStateException("Boundary inactive PID") }
        eraseBoundary(start, pid, 1)
        eraseBoundary(start + length, pid, 2)
        let last = active.removeLast()
        if (index < active.size) {
            active[index] = last
            position[Int64(last)] = Int32(index)
        }
        position[pid] = Int32(-1)
    }
    @OverflowWrapping
    public func sortedActiveByStart(pipes: ArrayList<Pipe>): Array<Int32> {
        let count = active.size
        if (count > 4096) { throw IllegalStateException("Boundary rare-path scale") }
        var ids = Array<Int32>(count, repeat: Int32(0))
        var scratch = Array<Int32>(count, repeat: Int32(0))
        for (i in 0..count) { ids[i] = active[i] }
        let offsets = Array<Int64>(256, repeat: 0)
        for (pass in 0..4) {
            offsets.fill(0)
            let shift = pass * 8
            for (i in 0..count) {
                let digit = (pipes[Int64(ids[i])].start >> shift) & 255
                offsets[digit]++
            }
            var total: Int64 = 0
            for (digit in 0..256) {
                let frequency = offsets[digit]
                offsets[digit] = total
                total += frequency
            }
            for (i in 0..count) {
                let pid = ids[i]
                let digit = (pipes[Int64(pid)].start >> shift) & 255
                scratch[offsets[digit]] = pid
                offsets[digit]++
            }
            let previous = ids
            ids = scratch
            scratch = previous
        }
        return ids
    }
}

