+    public operator func [](index: Int64): Int64 {
+        if (index < 0 || index >= used) { throw IndexOutOfBoundsException("Integer vector index") }
+        return unsafe { data.read(index) }
+    }
+
+    public operator func [](index: Int64, value!: Int64): Unit {
+        if (index < 0 || index >= used) { throw IndexOutOfBoundsException("Integer vector index") }
