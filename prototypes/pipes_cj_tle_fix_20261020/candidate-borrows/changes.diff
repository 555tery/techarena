+    public func rebuildCausalGapValues(maxGap: Int64): Unit {
+        if (maxGap < 0 || maxGap > kPrimalGapValueCap) { throw IndexOutOfBoundsException("DP limit") }
+        // All indices are within rates/reward[0..40], value[0..512]
+        // or causal rows[0..1025]; this owns every buffer throughout.
+        unsafe {
+            let requestRates = causalRequestRate.borrowData()
+            var lastRequest: Int64 = 40
+            while (lastRequest > 0 && requestRates.read(lastRequest) == 0.0) { lastRequest-- }
+            var firstRequest: Int64 = 1
+            while (firstRequest <= lastRequest && requestRates.read(firstRequest) == 0.0) { firstRequest++ }
+            let gapValues = causalGapValue.borrowData()
+            causalGapValue.fill(0.0)
+            for (model in 0..2) {
+                let offset: Int64 = model * 513
+                let expiry = causalBaseExpiry * (if (model == 0) { 0.5 } else { 2.0 })
+                for (gap in 1..=maxGap) {
+                    let top = iMin(gap, lastRequest)
+                    let reward = dpRewardScratch.borrowData()
+                    var active: Int64 = 0
+                    var numerator: Float64 = 0.0
+                    var denominator = expiry
+                    for (request in firstRequest..=top) {
+                        let requestRate = requestRates.read(request)
+                        if (requestRate == 0.0) { continue }
+                        let requestReward = Float64(request) + gapValues.read(offset + gap - request)
+                        reward.write(request, requestReward)
+                        numerator += requestRate * requestReward
+                        denominator += requestRate
+                        active = active | (1 << request)
+                    }
+                    var estimate = numerator / denominator
+                    while (true) {
+                        var removed = false
+                        for (request in firstRequest..=top) {
+                            let bit: Int64 = 1 << request
+                            if ((active & bit) != 0) {
+                                let rr = reward.read(request)
+                                if (rr < estimate) {
+                                    let requestRate = requestRates.read(request)
+                                    numerator -= requestRate * rr
+                                    denominator -= requestRate
+                                    active = active & (!bit)
+                                    removed = true
+                                }
+                            }
+                        }
+                        if (!removed) { break }
+                        estimate = numerator / denominator
+                    }
+                    gapValues.write(offset + gap, fMin(fMax(estimate, 0.0), Float64(gap)))
+                }
+            }
+            causalComputedLimit = maxGap
+        }
     }
 
